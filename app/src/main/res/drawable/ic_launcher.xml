<?xml version="1.0" encoding="utf-8"?>
<!-- 圖示：弓搭著箭，箭指向右邊的靶。圖案都放在中央的圓形安全區內，手錶桌面裁成圓形也不會被切掉。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底色 -->
    <path
        android:fillColor="#16261B"
        android:pathData="M0,0h108v108h-108z" />

    <!-- 靶：由外到內 白、紅、白、金 -->
    <path
        android:fillColor="#ECEFF1"
        android:pathData="M66,54 m-26,0 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0" />
    <path
        android:fillColor="#D32F2F"
        android:pathData="M66,54 m-20,0 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0" />
    <path
        android:fillColor="#ECEFF1"
        android:pathData="M66,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0" />
    <path
        android:fillColor="#FBC02D"
        android:pathData="M66,54 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />

    <!-- 弓身 -->
    <path
        android:pathData="M32,22 Q8,54 32,86"
        android:strokeColor="#D9B77E"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- 弓弦：被拉到箭尾 -->
    <path
        android:pathData="M32,22 L40,54 L32,86"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />

    <!-- 箭尾羽 -->
    <path
        android:pathData="M40,54 L35,49 M40,54 L35,59 M45,54 L40,49 M45,54 L40,59"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="2" />

    <!-- 箭桿 -->
    <path
        android:pathData="M40,54 L62,54"
        android:strokeColor="#CFD8DC"
        android:strokeLineCap="round"
        android:strokeWidth="2.4" />

    <!-- 箭頭 -->
    <path
        android:fillColor="#CFD8DC"
        android:pathData="M72,54 L61,49 L61,59 Z" />
